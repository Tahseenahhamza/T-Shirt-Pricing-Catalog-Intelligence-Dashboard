
/*
=========================================================
T-SHIRT PRICING & CATALOG INTELLIGENCE DASHBOARD
DAX CALCULATED COLUMNS AND MEASURES
=========================================================

Tables:
1. T-Shirt Products
2. Brand Tier Reference

Calculated Columns: 6
Measures: 12

=========================================================
PART 1: CALCULATED COLUMNS
Table: T-Shirt Products
=========================================================
*/


// 1. Profit Per Unit

Profit Per Unit =
'T-Shirt Products'[Sale Price] - 'T-Shirt Products'[Cost Price]


// 2. Profit Margin %

Profit Margin % =
DIVIDE(
    'T-Shirt Products'[Profit Per Unit],
    'T-Shirt Products'[Sale Price],
    0
)


// 3. Discount Amount

Discount Amount =
'T-Shirt Products'[Marked Price] - 'T-Shirt Products'[Sale Price]


// 4. Discount %

Discount % =
DIVIDE(
    'T-Shirt Products'[Discount Amount],
    'T-Shirt Products'[Marked Price],
    0
)


// 5. Price Band

Price Band =
SWITCH(
    TRUE(),
    ISBLANK('T-Shirt Products'[Sale Price]), "Unknown",
    'T-Shirt Products'[Sale Price] < 500, "1. Under 500",
    'T-Shirt Products'[Sale Price] < 1000, "2. 500 - 999",
    'T-Shirt Products'[Sale Price] < 2000, "3. 1,000 - 1,999",
    "4. 2,000 and above"
)


// 6. Discount Flag

Discount Flag =
IF(
    'T-Shirt Products'[Discount %] >= 0.70,
    "High Discount",
    "Normal"
)


/*
=========================================================
PART 2: MEASURES
=========================================================

Create each measure using Modeling > New Measure.

FOLDER 1: CORE METRICS
=========================================================
*/


// 1. Total Products

Total Products =
COUNTROWS('T-Shirt Products')


// 2. Total Brands

Total Brands =
DISTINCTCOUNT('T-Shirt Products'[Brand])


// 3. Avg Sale Price

Avg Sale Price =
AVERAGE('T-Shirt Products'[Sale Price])


// 4. Avg MRP

Avg MRP =
AVERAGE('T-Shirt Products'[Marked Price])


/*
=========================================================
FOLDER 2: DISCOUNT ANALYSIS
=========================================================
*/


// 5. Avg Discount %

Avg Discount % =
AVERAGE('T-Shirt Products'[Discount %])


// 6. MRP Inflation Ratio

MRP Inflation Ratio =
DIVIDE(
    [Avg MRP],
    [Avg Sale Price],
    0
)


// 7. Extreme Discount %

Extreme Discount % =
DIVIDE(
    CALCULATE(
        COUNTROWS('T-Shirt Products'),
        'T-Shirt Products'[Discount Flag] = "High Discount"
    ),
    [Total Products],
    0
)


/*
=========================================================
FOLDER 3: PROFITABILITY
=========================================================
*/


// 8. Est Avg Profit Margin %

Est Avg Profit Margin % =
AVERAGE('T-Shirt Products'[Profit Margin %])


// 9. Avg Profit Per Unit

Avg Profit Per Unit =
AVERAGE('T-Shirt Products'[Profit Per Unit])


/*
=========================================================
FOLDER 4: BRAND INTELLIGENCE
=========================================================
*/


// 10. Top Brand

Top Brand =
VAR BrandCounts =
    ADDCOLUMNS(
        VALUES('T-Shirt Products'[Brand]),
        "@Products",
        CALCULATE(COUNTROWS('T-Shirt Products'))
    )

VAR TopOne =
    TOPN(
        1,
        BrandCounts,
        [@Products], DESC,
        'T-Shirt Products'[Brand], ASC
    )

RETURN
    MAXX(
        TopOne,
        'T-Shirt Products'[Brand]
    )


// 11. Lowest Avg Price by Brand

Lowest Avg Price by Brand =
MINX(
    VALUES('T-Shirt Products'[Brand]),
    CALCULATE(
        AVERAGE('T-Shirt Products'[Sale Price])
    )
)


// 12. Highest Avg Price by Brand

Highest Avg Price by Brand =
MAXX(
    VALUES('T-Shirt Products'[Brand]),
    CALCULATE(
        AVERAGE('T-Shirt Products'[Sale Price])
    )
)


/*
=========================================================
PART 3: VALIDATION QUERY
=========================================================

Run separately in DAX Query View.
Do not create this as a measure.
=========================================================
*/


EVALUATE

ROW(
    "Total Products", [Total Products],
    "Total Brands", [Total Brands],
    "Avg Sale Price", [Avg Sale Price],
    "Avg Discount", [Avg Discount %],
    "MRP Inflation Ratio", [MRP Inflation Ratio],
    "Profit Margin", [Est Avg Profit Margin %],
    "Avg Profit Per Unit", [Avg Profit Per Unit],
    "Extreme Discount", [Extreme Discount %],
    "Top Brand", [Top Brand]
)
